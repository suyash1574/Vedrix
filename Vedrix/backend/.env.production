# Production environment template — inject real values through the deployment secret manager.
# Never commit provider credentials, SMTP passwords, JWT secrets, or Supabase keys.

# Security - REQUIRED in production; generate a unique value in the secret manager.
SECRET_KEY=change-me-in-the-deployment-secret-manager
CSRF_SECRET=change-me-in-the-deployment-secret-manager

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vedrix
DB_SSL_MODE=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30

# AI API Keys - inject at runtime
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
APIFREE_API_KEY=

# NVIDIA Object-Oriented Agents (research preview; enable only after parity testing)
NOOA_ENABLED=false
NOOA_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
VEDRIX_NOOA_GRAPH=false

GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Redis for caching
REDIS_URL=redis://redis:6379/0

# Environment
ENVIRONMENT=production

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (optional - inject credentials at runtime)
EMAIL_BACKEND=console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Vedrix AI

# Frontend URL
FRONTEND_URL=https://your-production-domain.com
ALLOWED_ORIGINS=https://your-production-domain.com

# Judge0 (optional - for code execution)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
